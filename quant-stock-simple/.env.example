# Get a free key from https://aistudio.google.com/apikey — never commit this file.
GEMINI_API_KEY=
# Change if Google retires the default (check https://ai.google.dev/gemini-api/docs/models for current names).
GEMINI_MODEL=gemini-3.1-flash-lite

# Comma-separated NSE symbols to track. Keep this list modest (20-40) — each
# refresh makes one yfinance + one Google-News-RSS call per symbol.
WATCHLIST=RELIANCE,TCS,INFY,HDFCBANK,ICICIBANK,SBIN,LT,ITC,BHARTIARTL,HINDUNILVR,MARUTI,SUNPHARMA,TITAN,AXISBANK,KOTAKBANK,BAJFINANCE,ASIANPAINT,WIPRO,ULTRACEMCO,NESTLEIND

PORT=8000
